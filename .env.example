# ==============================================================================
# Configuración de Banca AI
#
# Copiá este archivo a `.env` y completá los valores:
#   cp env.template .env
#
# El único valor que SÍ o SÍ tenés que cambiar para que el chat con IA funcione
# es OPENROUTER_API_KEY. El resto tiene defaults que sirven para desarrollo.
# ==============================================================================

# ------------------------------------------------------------------------------
# Entorno
# ------------------------------------------------------------------------------
# "development" habilita logs legibles y CORS permisivo.
# "production" fuerza logs JSON, cookies Secure y CORS restringido.
ENV=development

# Puerto donde escucha la API.
API_PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL — usuarios y autenticación
#
# Ojo con la división de responsabilidades: Postgres guarda usuarios,
# credenciales y metadatos de cuentas. NO guarda saldos ni transacciones,
# de eso se encarga TigerBeetle.
# ------------------------------------------------------------------------------
POSTGRES_USER=banca
POSTGRES_PASSWORD=banca_dev_password
POSTGRES_DB=banca
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ------------------------------------------------------------------------------
# TigerBeetle — operaciones financieras
#
# IMPORTANTE: la versión del servidor y la del cliente Go tienen que coincidir
# exactamente (0.17.9). El protocolo cambia entre releases y una desalineación
# da errores de conexión difíciles de diagnosticar.
# ------------------------------------------------------------------------------
TIGERBEETLE_CLUSTER_ID=0
TIGERBEETLE_ADDRESSES=tigerbeetle:3000

# ------------------------------------------------------------------------------
# Autenticación
#
# JWT_SECRET firma los access tokens. En producción tiene que ser un valor
# aleatorio de al menos 32 bytes. Generalo con:
#   openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=

# Duración del access token. Corto a propósito: si te lo roban, expira rápido.
ACCESS_TOKEN_TTL=15m

# Duración del refresh token. Vive en una cookie httpOnly y rota en cada uso.
REFRESH_TOKEN_TTL=168h

# Costo de bcrypt para usuarios registrados por la aplicación.
# Este es el valor que protege passwords reales de personas.
BCRYPT_COST=12

# ------------------------------------------------------------------------------
# OpenRouter — proveedor del modelo de IA
#
# Conseguí tu key en https://openrouter.ai/keys
# Sin esta variable el chat con IA no funciona (el resto de la app sí).
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Rate limiting
#
# Los endpoints de autenticación tienen un límite más estricto que el resto,
# porque son el blanco natural de un ataque de fuerza bruta.
# ------------------------------------------------------------------------------
RATE_LIMIT_GENERAL_RPM=120
RATE_LIMIT_AUTH_RPM=10

# ------------------------------------------------------------------------------
# Seed — carga de datos de prueba
#
# SEED_ENABLED controla si se siembran los datos al levantar el sistema.
# SEED_USER_LIMIT limita cuántos usuarios cargar (0 = todos, los 1.000).
#
# SEED_BCRYPT_COST es MENOR que BCRYPT_COST a propósito. Los passwords de los
# datos de prueba ya vienen en texto plano en el JSON del repositorio, así que
# un costo alto no aporta seguridad real y sí hace lento el primer arranque.
# Los usuarios que se registren por la aplicación siempre usan BCRYPT_COST.
# El costo queda guardado dentro del propio hash, así que ambos conviven.
# ------------------------------------------------------------------------------
SEED_ENABLED=true
SEED_USER_LIMIT=0
SEED_BCRYPT_COST=10

# ------------------------------------------------------------------------------
# Frontend
#
# URL pública de la API que consume el navegador. En docker-compose el browser
# accede por localhost, no por el nombre del servicio interno.
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# Origen permitido por CORS. Es de donde se sirve el frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173
